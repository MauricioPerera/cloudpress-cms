{
  "$schema": "https://unpkg.com/wrangler@4.103.0/config-schema.json",
  "name": "cloudpress",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-09-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudpress-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cloudpress-media"
    }
  ]
}
