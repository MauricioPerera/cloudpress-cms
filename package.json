{
  "name": "cloudpress",
  "private": true,
  "type": "module",
  "scripts": {
    "webmcp:build": "node scripts/build-fastwebmcp.mjs",
    "plugins:build": "node scripts/generate-plugin-registry.mjs",
    "plugins:validate": "node scripts/validate-plugin.mjs plugins/cloudpress-commerce",
    "openapi:build": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "test:openapi": "node scripts/verify-openapi.mjs",
    "test:api-errors": "node scripts/verify-api-errors.mjs",
    "test:http-guards": "node scripts/verify-http-guards.mjs",
    "test:approvals": "node scripts/verify-approvals.mjs",
    "test:agent-capability": "node scripts/verify-agent-capability.mjs && node scripts/verify-agent-capability-management.mjs",
    "test:agent-os": "node scripts/verify-agent-os.mjs && node scripts/verify-agent-contracts.mjs && node scripts/verify-agent-execution.mjs",
    "test:password-hardening": "node scripts/verify-password-hardening.mjs",
    "test:totp": "node scripts/verify-totp.mjs",
    "test:totp-recovery": "node scripts/verify-totp-recovery.mjs",
    "test:recovery-pdf": "node scripts/verify-recovery-pdf.mjs",
    "test:scheduler": "node scripts/verify-scheduler.mjs",
    "test:d1-migrate": "node scripts/verify-d1-migrate.mjs && node scripts/verify-d1-native-migrate.mjs",
    "d1:migrate": "node scripts/d1-migrate.mjs",
    "test:fastwebmcp": "node scripts/verify-fastwebmcp.mjs",
    "test:plugin-host": "node scripts/verify-plugin-host.mjs",
    "test:public-plugin-api": "node scripts/verify-public-plugin-api.mjs",
    "test:plugin-admin-ui": "node scripts/verify-plugin-admin-ui.mjs",
    "test:plugin-boundaries": "node scripts/verify-plugin-boundaries.mjs",
    "test:roles": "node scripts/verify-roles.mjs",
    "test:core-content-types": "node scripts/verify-core-content-types.mjs",
    "test:admin-subpage-ui": "node scripts/verify-admin-subpage-ui.mjs",
    "test:admin-ui-confirmation-flow": "node scripts/verify-admin-ui-confirmation-flow.mjs",
    "test:schema": "node scripts/verify-schema-contract.mjs",
    "test:syntax": "node scripts/check-syntax.mjs",
    "test": "npm run webmcp:build && npm run plugins:build && npm run openapi:build && npm run plugins:validate && npm run test:plugin-host && npm run test:public-plugin-api && npm run test:plugin-admin-ui && npm run test:plugin-boundaries && npm run test:openapi && npm run test:api-errors && npm run test:admin-ui-confirmation-flow && npm run test:http-guards && npm run test:approvals && npm run test:agent-capability && npm run test:agent-os && npm run test:roles && npm run test:core-content-types && npm run test:admin-subpage-ui && npm run test:password-hardening && npm run test:totp && npm run test:totp-recovery && npm run test:recovery-pdf && npm run test:scheduler && npm run test:d1-migrate && npm run test:fastwebmcp && npm run test:schema && npm run test:syntax"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "fastwebmcp": "^0.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.5.4"
  }
}
